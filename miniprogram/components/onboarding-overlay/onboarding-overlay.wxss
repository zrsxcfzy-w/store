.onboarding-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(0, 0, 0, 0.46);
  box-sizing: border-box;
  padding: 32rpx;
}

.onboarding-highlight {
  position: absolute;
  border-radius: 18rpx;
  border: 4rpx solid #ffffff;
  box-shadow: 0 0 0 9999rpx rgba(0, 0, 0, 0.46), 0 10rpx 28rpx rgba(0, 0, 0, 0.2);
  pointer-events: none;
}

.onboarding-card {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  padding: 30rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  background: #ffffff;
  border: 1rpx solid #ececec;
  box-shadow: 0 10rpx 30rpx rgba(45, 37, 28, 0.14);
}

.target-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.target-center .onboarding-card {
  position: static;
}

.target-home-card .onboarding-highlight {
  top: 318rpx;
  left: 140rpx;
  right: 24rpx;
  height: 194rpx;
}

.target-home-card .onboarding-card {
  top: 536rpx;
}

.target-home-filter .onboarding-highlight {
  top: 174rpx;
  left: 24rpx;
  right: 24rpx;
  height: 204rpx;
}

.target-home-filter .onboarding-card {
  top: 402rpx;
}

.target-home-detail .onboarding-highlight {
  top: 276rpx;
  left: 24rpx;
  right: 24rpx;
  height: 430rpx;
}

.target-home-detail .onboarding-card {
  bottom: 142rpx;
}

.target-detail-stock .onboarding-highlight {
  top: 470rpx;
  left: 42rpx;
  right: 42rpx;
  height: 164rpx;
}

.target-detail-stock .onboarding-card {
  bottom: 62rpx;
}

.target-reminder-panel .onboarding-highlight {
  top: 112rpx;
  left: 24rpx;
  right: 24rpx;
  height: 276rpx;
}

.target-reminder-panel .onboarding-card {
  top: 420rpx;
}

.target-page-hint .onboarding-highlight {
  top: 88rpx;
  left: 24rpx;
  right: 24rpx;
  height: 166rpx;
}

.target-page-hint .onboarding-card {
  top: 286rpx;
}

.onboarding-step {
  color: #8c8c8c;
  font-size: 23rpx;
  margin-bottom: 10rpx;
}

.onboarding-title {
  color: #202020;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.onboarding-text {
  margin-top: 14rpx;
  color: #4f4f4f;
  font-size: 27rpx;
  line-height: 1.55;
}

.onboarding-actions {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.onboarding-actions.finish-actions {
  grid-template-columns: 1fr 1fr;
}

.onboarding-actions.single-action {
  grid-template-columns: 1fr;
}

.primary-button,
.secondary-button {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
}

.primary-button {
  background: linear-gradient(180deg, #70c884 0%, #5fbd78 100%);
  color: #ffffff;
  font-weight: 700;
}

.secondary-button {
  background: #f3f3f3;
  color: #555555;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.variant-guide {
  padding: 0;
  background: transparent;
}

.variant-guide.target-center {
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.58);
}

.variant-guide .onboarding-highlight {
  border-radius: 18rpx;
  border: 4rpx solid #ffffff;
  background: rgba(255, 255, 255, 0.04);
  box-shadow: 0 0 0 9999rpx rgba(0, 0, 0, 0.58), 0 0 0 8rpx rgba(116, 77, 255, 0.18), 0 10rpx 28rpx rgba(0, 0, 0, 0.24);
}

.variant-guide .onboarding-card {
  left: 56rpx;
  right: 56rpx;
  padding: 28rpx;
  border-radius: 14rpx;
  border: 0;
  background: #7047f5;
  color: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(28, 20, 82, 0.28);
}

.variant-guide.target-center .onboarding-card {
  position: static;
}

.variant-guide .onboarding-step {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.variant-guide .onboarding-title {
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 800;
}

.variant-guide .onboarding-text {
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  line-height: 1.55;
}

.variant-guide .onboarding-actions {
  margin-top: 24rpx;
  grid-template-columns: 1fr 1fr;
}

.variant-guide .primary-button,
.variant-guide .secondary-button {
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.variant-guide .primary-button {
  background: rgba(255, 255, 255, 0.15);
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.86);
}

.variant-guide .secondary-button {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(255, 255, 255, 0.34);
}
