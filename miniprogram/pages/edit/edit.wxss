.image-box {
  height: 300rpx;
  border-radius: 26rpx;
  background: #fff1e3;
  color: #8a827d;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 22rpx;
}

.image-box image {
  width: 100%;
  height: 100%;
}

.form {
  padding: 22rpx;
}

.field {
  min-height: 82rpx;
  border-bottom: 1rpx solid #f0e7df;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
}

.field input {
  flex: 1;
  text-align: right;
}

.field.column {
  min-height: 116rpx;
  align-items: flex-start;
  flex-direction: column;
  justify-content: center;
}

.field.column input {
  width: 100%;
  text-align: left;
}

.save-button {
  margin-top: 30rpx;
  height: 82rpx;
  line-height: 82rpx;
  color: #ffffff;
  background: #8bd7d2;
  font-weight: 800;
}
