.home-page {
  padding-bottom: 190rpx;
  background: #fffdf9;
}

.topbar {
  margin-bottom: 14rpx;
}

.house-title {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  font-weight: 700;
  min-width: 0;
}

.house-icon {
  width: 38rpx;
  height: 38rpx;
  border-radius: 8rpx;
  border: 2rpx solid #55ad69;
  color: #55ad69;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.house-copy {
  flex: 1;
  min-width: 0;
}

.house-name {
  display: block;
  font-size: 30rpx;
  line-height: 40rpx;
}

.top-actions {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}

.tool-button {
  height: 46rpx;
  line-height: 46rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid #dfdfdf;
  background: #ffffff;
  color: #444444;
  font-size: 19rpx;
  white-space: nowrap;
}

.mini-icon {
  color: #666666;
  font-size: 18rpx;
}

.search-bar {
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  border: 1rpx solid #eeeeee;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-bar input {
  flex: 1;
  color: #333333;
  font-size: 23rpx;
}

.search-icon {
  color: #bbbbbb;
  font-size: 30rpx;
}

.layout {
  margin-top: 22rpx;
}

.location-row {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.location-cell {
  height: 78rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 700;
  overflow: hidden;
}

.item-cell {
  color: #111111;
  background: #ffffff;
  border: 1rpx solid #eeeeee;
}

.item-cell.active,
.category-cell.selected {
  border: 2rpx solid #65bd7d;
  color: #45a761;
}

.color-cell {
  color: #ffffff;
}

.color-cell.selected {
  box-shadow: 0 0 0 4rpx rgba(83, 177, 105, 0.22);
  transform: translateY(-2rpx);
}

.content-row {
  display: flex;
  gap: 12rpx;
  position: relative;
}

.category-column {
  width: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 13rpx;
  flex-shrink: 0;
}

.category-cell {
  width: 100%;
  min-height: 78rpx;
  padding: 6rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.58);
  color: #222222;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 23rpx;
  line-height: 1.25;
  border: 1rpx solid transparent;
}

.item-list {
  flex: 1;
  min-width: 0;
  height: calc(100vh - 500rpx);
}

.item-card {
  min-height: 184rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 14rpx;
  display: flex;
  gap: 12rpx;
  align-items: center;
  border-radius: 14rpx;
}

.item-thumb {
  width: 146rpx;
  height: 156rpx;
  border-radius: 12rpx;
  background: transparent;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #222222;
}

.card-side {
  width: 198rpx;
  align-self: stretch;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.location-pill {
  color: #ffffff;
  border-radius: 10rpx;
  min-width: 88rpx;
  max-width: 176rpx;
  padding: 7rpx 16rpx;
  font-size: 21rpx;
  font-weight: 700;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 34rpx;
  box-sizing: border-box;
}

.location-pill text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-grid {
  display: grid;
  gap: 6rpx;
  color: #666666;
  font-size: 22rpx;
}

.next-text {
  font-weight: 700;
}

.next-text.expired {
  color: #f04f4f;
}

.next-text.pending {
  color: #35a85c;
}

.expired-callout,
.low-stock-callout {
  width: 100%;
  min-height: 66rpx;
  color: #f04f4f;
  font-size: 27rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-bubble {
  position: fixed;
  z-index: 6;
  min-height: 58rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 2rpx solid #7ecf91;
  color: #46a761;
  font-size: 21rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(72, 167, 101, 0.12);
}

.guide-bubble::before {
  content: "";
  position: absolute;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 22rpx solid #7ecf91;
  top: -22rpx;
  left: 44rpx;
}

.location-guide {
  left: 148rpx;
  top: 278rpx;
}

.item-guide {
  left: 122rpx;
  bottom: 174rpx;
  max-width: 260rpx;
  text-align: center;
}

.add-button {
  width: 50rpx;
  height: 50rpx;
  min-width: 50rpx;
  min-height: 50rpx;
  max-width: 50rpx;
  max-height: 50rpx;
  border-radius: 50%;
  border: 2rpx solid #62bd7b;
  background: #ffffff;
  color: #56b86f;
  font-size: 34rpx;
  line-height: 1;
  margin: 0 auto;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(75, 172, 100, 0.18);
}

.add-button::after {
  border: 0;
}

.modal-mask,
.guide-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(0, 0, 0, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
}

.manual-panel,
.guide-card {
  width: 100%;
  max-height: 82vh;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 34rpx;
  box-sizing: border-box;
}

.manual-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
}

.manual-body {
  height: 58vh;
  max-height: 58vh;
  padding-right: 4rpx;
}

.manual-section {
  margin-bottom: 24rpx;
}

.manual-section:last-child {
  margin-bottom: 0;
}

.manual-section-title {
  margin-bottom: 10rpx;
  color: #2d2d2d;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.manual-line {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  line-height: 1.6;
  margin-bottom: 10rpx;
  color: #4a4a4a;
  font-size: 25rpx;
}

.manual-line:last-child {
  margin-bottom: 0;
}

.manual-dot {
  width: 9rpx;
  height: 9rpx;
  margin-top: 16rpx;
  border-radius: 50%;
  background: #62bd7b;
  flex-shrink: 0;
}

.manual-line-text {
  flex: 1;
  min-width: 0;
}

.confirm-button {
  margin-top: 24rpx;
  height: 78rpx;
  line-height: 78rpx;
  color: #ffffff;
  background: #62bd7b;
  font-weight: 700;
}

.guide-step {
  color: #989898;
  margin-bottom: 12rpx;
}

.guide-text {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.5;
}
