.home-page {
  padding-bottom: 148rpx;
  background: #fffdf9;
}

.topbar {
  margin-bottom: 14rpx;
}

.house-title {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  font-weight: 700;
  min-width: 0;
}

.house-icon {
  width: 38rpx;
  height: 38rpx;
  border-radius: 8rpx;
  border: 2rpx solid #55ad69;
  color: #55ad69;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.house-copy {
  flex: 1;
  min-width: 0;
}

.house-name {
  display: block;
  font-size: 30rpx;
  line-height: 40rpx;
}

.top-actions {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}

.tool-button {
  height: 46rpx;
  line-height: 46rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid #dfdfdf;
  background: #ffffff;
  color: #444444;
  font-size: 19rpx;
  white-space: nowrap;
}

.mini-icon {
  color: #666666;
  font-size: 18rpx;
}

.search-bar {
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  border: 1rpx solid #eeeeee;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-bar input {
  flex: 1;
  color: #333333;
  font-size: 23rpx;
}

.search-icon {
  color: #bbbbbb;
  font-size: 30rpx;
}

.layout {
  margin-top: 22rpx;
}

.location-row {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.location-cell {
  height: 78rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 700;
  overflow: hidden;
}

.item-cell {
  color: #111111;
  background: #ffffff;
  border: 1rpx solid #eeeeee;
}

.item-cell.active,
.category-cell.selected {
  border: 2rpx solid #65bd7d;
  color: #45a761;
}

.color-cell {
  color: #ffffff;
}

.color-cell.selected {
  box-shadow: 0 0 0 4rpx rgba(83, 177, 105, 0.22);
  transform: translateY(-2rpx);
}

.content-row {
  display: flex;
  gap: 12rpx;
  position: relative;
}

.category-column {
  width: 104rpx;
  display: flex;
  flex-direction: column;
  gap: 13rpx;
  flex-shrink: 0;
}

.category-cell {
  min-height: 78rpx;
  padding: 6rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.58);
  color: #222222;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 23rpx;
  line-height: 1.25;
  border: 1rpx solid transparent;
}

.item-list {
  flex: 1;
  height: calc(100vh - 348rpx);
}

.item-card {
  min-height: 184rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 14rpx;
  display: flex;
  gap: 12rpx;
  align-items: center;
  border-radius: 14rpx;
}

.item-thumb {
  width: 146rpx;
  height: 156rpx;
  border-radius: 12rpx;
  background: transparent;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.item-name {
  font-size: 22rpx;
  font-weight: 600;
  color: #222222;
}

.location-pill {
  color: #ffffff;
  border-radius: 999rpx;
  min-width: 92rpx;
  padding: 7rpx 18rpx;
  font-size: 21rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.card-grid {
  margin-top: 12rpx;
  display: grid;
  gap: 6rpx;
  color: #666666;
  font-size: 22rpx;
}

.danger {
  color: #ff7634;
  font-weight: 700;
}

.guide-bubble {
  position: fixed;
  z-index: 6;
  min-height: 58rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 2rpx solid #7ecf91;
  color: #46a761;
  font-size: 21rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(72, 167, 101, 0.12);
}

.guide-bubble::before {
  content: "";
  position: absolute;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 22rpx solid #7ecf91;
  top: -22rpx;
  left: 44rpx;
}

.location-guide {
  left: 148rpx;
  top: 278rpx;
}

.item-guide {
  left: 122rpx;
  bottom: 174rpx;
  max-width: 260rpx;
  text-align: center;
}

.add-button {
  position: fixed;
  right: 42rpx;
  bottom: 138rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #72c986 0%, #59ba75 100%);
  color: #ffffff;
  font-size: 54rpx;
  line-height: 82rpx;
  z-index: 12;
  box-shadow: 0 10rpx 24rpx rgba(75, 172, 100, 0.28);
}

.modal-mask,
.guide-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(0, 0, 0, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
}

.manual-panel,
.guide-card {
  width: 100%;
  max-height: 82vh;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 34rpx;
  box-sizing: border-box;
}

.manual-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
}

.manual-body {
  max-height: 58vh;
}

.manual-line {
  line-height: 1.7;
  margin-bottom: 14rpx;
  color: #4a4a4a;
}

.confirm-button {
  margin-top: 24rpx;
  height: 78rpx;
  line-height: 78rpx;
  color: #ffffff;
  background: #62bd7b;
  font-weight: 700;
}

.guide-step {
  color: #989898;
  margin-bottom: 12rpx;
}

.guide-text {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.5;
}
