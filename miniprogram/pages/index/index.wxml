<view class="page home-page">
  <view class="topbar">
    <view class="house-title">
      <text class="house-icon">⌂</text>
      <view class="house-copy">
        <text class="house-name">关于 {{house.name}}</text>
        <view class="top-actions">
          <button class="tool-button guide-manual-button" bindtap="openManual"><text class="mini-icon">▣</text> 查看使用说明</button>
          <button class="tool-button guide-export-button" bindtap="exportList"><text class="mini-icon">⇩</text> 导出清单</button>
        </view>
      </view>
    </view>
  </view>

  <view class="search-bar">
    <text class="search-icon">⌕</text>
    <input value="{{searchKeyword}}" bindinput="onSearchInput" placeholder="搜索物品名称" />
  </view>

  <view class="layout">
    <view class="location-row">
      <view class="location-cell item-cell {{activeLocationId || activeCategoryId ? '' : 'active'}}" bindtap="clearFilters">全部物品</view>
      <view
        wx:for="{{house.locations}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="onLocationTap"
        bindlongpress="onLocationLongPress"
        class="location-cell color-cell {{activeLocationId === item.id ? 'selected' : ''}}"
        style="background-color: {{item.color}};"
      >
        {{item.name}}
      </view>
    </view>

    <view class="content-row">
      <view class="category-column">
        <view
          wx:for="{{house.categories}}"
          wx:key="id"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          bindtap="onCategoryTap"
          bindlongpress="onCategoryLongPress"
          class="category-cell {{activeCategoryId === item.id ? 'selected' : ''}}"
        >
          {{item.name}}
        </view>
        <button class="add-button guide-add-button" bindtap="goEdit">+</button>
      </view>

      <scroll-view scroll-y class="item-list">
        <view
          wx:for="{{filteredItems}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="goDetail"
          bindlongpress="onItemLongPress"
          class="item-card panel"
        >
          <image class="item-thumb" src="{{item.imageUrl}}" mode="aspectFit"></image>
          <view class="item-info">
            <view class="card-grid">
              <text class="item-name">{{item.name}}</text>
              <text>剩余库存: {{item.stock}}{{item.unit}}</text>
              <text>周期: {{item.cycleDays}}天</text>
              <text wx:if="{{item.nextSuggestedText !== '已到期'}}" class="next-text pending">预计购买: {{item.nextSuggestedText}}</text>
            </view>
          </view>
          <view class="card-side">
            <view class="location-pill" style="background-color: {{item.locationColor}};">
              <text>{{item.displayLocation}}</text>
            </view>
            <view wx:if="{{item.stock <= 2}}" class="low-stock-callout">库存较少</view>
            <view wx:if="{{item.nextSuggestedText === '已到期'}}" class="expired-callout">已到期,请及时采购</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="bottom-tabbar">
    <view class="tab-item active" bindtap="goHome">
      <image class="tab-img" src="/assets/tab-home-active.png" mode="aspectFit"></image>
      <text>首页</text>
    </view>
    <view class="tab-item" bindtap="goInventory">
      <image class="tab-img" src="/assets/tab-inventory.png" mode="aspectFit"></image>
      <text>库存</text>
    </view>
    <view class="tab-item" bindtap="goReminder">
      <image class="tab-img" src="/assets/tab-reminder.png" mode="aspectFit"></image>
      <text>提醒</text>
    </view>
    <view class="tab-item" bindtap="goBills">
      <image class="tab-img" src="/assets/tab-bill.png" mode="aspectFit"></image>
      <text>账单</text>
    </view>
    <view class="tab-item" bindtap="goAccounting">
      <image class="tab-img" src="/assets/tab-accounting.png" mode="aspectFit"></image>
      <text>记账</text>
    </view>
    <view class="tab-item guide-profile-tab" bindtap="goProfile">
      <image class="tab-img" src="/assets/tab-profile.png" mode="aspectFit"></image>
      <text>我的</text>
    </view>
  </view>

  <view wx:if="{{manualVisible}}" class="modal-mask">
    <view class="manual-panel">
      <view class="manual-title">家庭库存管理使用说明</view>
      <scroll-view scroll-y class="manual-body">
        <view wx:for="{{manualSections}}" wx:for-item="section" wx:key="title" class="manual-section">
          <view class="manual-section-title">{{section.title}}</view>
          <view wx:for="{{section.items}}" wx:for-item="line" wx:key="*this" class="manual-line">
            <view class="manual-dot"></view>
            <text class="manual-line-text">{{line}}</text>
          </view>
        </view>
      </scroll-view>
      <button class="confirm-button" bindtap="closeManual">我知道了</button>
    </view>
  </view>

  <onboarding-overlay
    visible="{{onboarding.visible}}"
    target="{{onboarding.target}}"
    variant="{{onboarding.variant}}"
    step-text="{{onboarding.stepText}}"
    title="{{onboarding.title}}"
    text="{{onboarding.text}}"
    primary-text="{{onboarding.primaryText}}"
    secondary-text="{{onboarding.secondaryText}}"
    show-secondary="{{onboarding.showSecondary}}"
    finish-mode="{{onboarding.finishMode}}"
    highlight-style="{{onboarding.highlightStyle}}"
    card-style="{{onboarding.cardStyle}}"
    bind:primary="onOnboardingPrimary"
    bind:secondary="onOnboardingSecondary"
  />
</view>
