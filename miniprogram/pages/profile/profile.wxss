.profile-page {
  padding-bottom: 146rpx;
  background: #fffdf9;
}

.profile-head {
  padding-top: 54rpx;
  display: flex;
  justify-content: center;
}

.avatar {
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  border: 2rpx solid #97d5a7;
  background: #fffefb;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #a5a5a5;
  overflow: hidden;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.camera {
  font-size: 58rpx;
  color: #cfcfcf;
}

.avatar-tip {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #999999;
}

.name-card {
  margin-top: 42rpx;
  padding: 26rpx 28rpx;
  border-radius: 18rpx;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.name-row > view {
  flex: 1;
  min-width: 0;
}

.name-label {
  font-size: 28rpx;
  font-weight: 700;
}

.name-row input {
  display: inline-block;
  width: 260rpx;
  height: 44rpx;
  font-weight: 700;
  color: #333333;
}

.name-tip {
  display: block;
  margin-top: 10rpx;
  color: #9a9a9a;
  font-size: 21rpx;
}

.edit-icon {
  color: #b5b5b5;
  font-size: 34rpx;
}

.function-grid {
  margin-top: 26rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.function-cell {
  height: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #333333;
  font-weight: 700;
}

.function-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 800;
}

.function-icon.green {
  background: #78c78a;
}

.function-icon.blue {
  background: #73bde8;
}

.function-icon.orange {
  background: #ff9f57;
}

.function-icon.purple {
  background: #b894df;
}

.function-icon.red {
  background: #f07f7f;
}

.tip-panel {
  margin: 24rpx 0 0;
  min-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  border: 2rpx solid #7ecf91;
  background: #ffffff;
  color: #48a765;
  display: flex;
  align-items: center;
  font-weight: 700;
  font-size: 22rpx;
  justify-content: center;
}

.house-action-row {
  margin: 28rpx -14rpx 0;
  height: 78rpx;
  display: flex;
  gap: 16rpx;
}

.house-action-button {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  line-height: normal;
  border-radius: 14rpx;
  font-size: 25rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(0, 0, 0, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  box-sizing: border-box;
}

.switch-modal {
  width: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.field {
  min-height: 76rpx;
  border-bottom: 1rpx solid #f1f1f1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #444444;
  font-size: 24rpx;
}

.field text:last-child {
  flex: 1;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-actions {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
}

.modal-actions button {
  width: 100%;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}

.cancel-button {
  background: #f2f2f2;
  color: #333333;
}

.cancel-button::after {
  border: 0;
}
