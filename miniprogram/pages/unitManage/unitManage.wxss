.manage-page {
  background: #fffdf9;
  padding-bottom: 52rpx;
}

.add-action {
  margin-top: 24rpx;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
}

.manage-row {
  margin-top: 18rpx;
  padding: 22rpx;
}

.row-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
}

.row-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #222222;
}

.row-meta {
  color: #777777;
  font-size: 23rpx;
}

.row-actions {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.row-actions button {
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 12rpx;
  background: #f5f7f4;
  color: #444444;
  font-size: 22rpx;
}

.row-actions .danger-text {
  background: #fff0f0;
  color: #d94444;
}

.notice {
  margin-top: 22rpx;
  padding: 22rpx;
  color: #666666;
  font-size: 24rpx;
  line-height: 1.55;
}
