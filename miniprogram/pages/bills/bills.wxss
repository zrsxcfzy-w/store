@import "../bill/bill.wxss";

.bills-page {
  padding-bottom: 148rpx;
  background: #fffdf9;
}

.title-row {
  min-height: 66rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.title-actions {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: center;
  gap: 14rpx;
}

.add-record-button {
  width: 100%;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  min-width: 0;
  border: 2rpx solid #ffffff;
  box-shadow: 0 0 0 2rpx #4fac67;
  box-sizing: border-box;
}

.batch-button {
  width: 100%;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  min-width: 0;
  border: 2rpx solid #ffffff;
  box-shadow: 0 0 0 2rpx #4fac67;
  box-sizing: border-box;
}

.danger-button {
  width: 154rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}

.fold-all-button {
  width: 100%;
}

.batch-button {
  background: linear-gradient(180deg, #70c884 0%, #5fbd78 100%);
  color: #ffffff;
  font-weight: 700;
}

.danger-button {
  background: #e64340;
  color: #ffffff;
  font-weight: 700;
}

.batch-bar {
  min-height: 68rpx;
  margin: -4rpx 0 18rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #fff4f4;
  color: #c93636;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.bills-scroll {
  height: calc(100vh - 286rpx);
}

.date-group {
  margin-bottom: 34rpx;
  padding: 18rpx 14rpx 4rpx;
  box-sizing: border-box;
}

.date-group-header {
  min-height: 92rpx;
  display: grid;
  grid-template-columns: minmax(0, 250rpx) minmax(0, 1fr) 96rpx;
  gap: 12rpx;
  align-items: center;
}

.date-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.fold-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #f2f2f2;
  color: #444444;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Arial, sans-serif;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  flex-shrink: 0;
  box-sizing: border-box;
}

.select-box {
  width: 38rpx;
  height: 38rpx;
  border-radius: 8rpx;
  border: 2rpx solid #d4d4d4;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.select-box.selected {
  border-color: #e64340;
  background: #e64340;
}

.date-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #2d2d2d;
  overflow: visible;
  white-space: nowrap;
}

.date-summary {
  color: #333333;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.35;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}

.group-delete-button {
  width: 96rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 12rpx;
  background: #ff4d4f;
  color: #111111;
  font-size: 22rpx;
  font-weight: 800;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.group-delete-button::after {
  border: 0;
}

.group-records {
  margin-top: 14rpx;
}

.bills-page .bill-head,
.bills-page .record {
  grid-template-columns: minmax(0, 1.12fr) minmax(0, 1.08fr) minmax(0, 0.88fr) minmax(0, 0.76fr);
  gap: 14rpx;
}

.bills-page .bill-head text:nth-child(1) {
  padding-left: 52rpx;
  box-sizing: border-box;
}

.bills-page .bill-head text:nth-child(2),
.bills-page .bill-head text:nth-child(3) {
  text-align: center;
}

.bills-page .bill-head text:nth-child(2) {
  padding-left: 0;
}

.bills-page .bill-head text:nth-child(4) {
  text-align: right;
}

.bills-page .record {
  box-shadow: none;
  border: 0;
  border-radius: 0;
  border-top: 1rpx solid #f0f0f0;
  margin-bottom: 0;
}

.bill-item-name {
  color: #333333;
  font-size: 23rpx;
  line-height: 1.25;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bills-page .platform {
  min-width: 0;
}

.bills-page .price,
.bills-page .quantity {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(0, 0, 0, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  box-sizing: border-box;
}

.record-modal {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  padding: 24rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.choice-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.choice-row.secondary {
  margin-top: 2rpx;
}

.choice-pill {
  height: 60rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
  color: #333333;
  font-size: 23rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.choice-pill.active {
  background: #e7f6ea;
  color: #319652;
}

.image-upload {
  height: 154rpx;
  margin: 12rpx 0;
  border-radius: 14rpx;
  background: #f5fbf6;
  border: 1rpx dashed #9bd5aa;
  color: #61a574;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.image-upload image {
  width: 100%;
  height: 100%;
}

.modal-actions {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
}

.modal-actions button {
  width: 100%;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}

.modal-actions .submit {
  margin-top: 0;
}

.cancel-button {
  background: #f2f2f2;
  color: #333333;
}

.cancel-button::after {
  border: 0;
}
