@import "../bill/bill.wxss";

.bills-page {
  padding-bottom: 148rpx;
  background: #fffdf9;
}

.title-row {
  min-height: 66rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 0;
}

.add-record-button {
  width: 224rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.bills-scroll {
  height: calc(100vh - 286rpx);
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(0, 0, 0, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  box-sizing: border-box;
}

.record-modal {
  width: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}
