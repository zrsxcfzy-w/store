@import "../bill/bill.wxss";

.bills-page {
  padding-bottom: 148rpx;
  background: #fffdf9;
}

.title-row {
  min-height: 66rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 0;
}

.add-record-button {
  width: 224rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.bills-scroll {
  height: calc(100vh - 286rpx);
}

.bills-page .bill-head,
.bills-page .record {
  grid-template-columns: 1.08fr 1.18fr 0.95fr 0.86fr 0.62fr;
  gap: 8rpx;
}

.bills-page .bill-head text:nth-child(2) {
  padding-left: 54rpx;
  box-sizing: border-box;
}

.bills-page .bill-head text:nth-child(3),
.bills-page .bill-head text:nth-child(4) {
  text-align: center;
}

.bills-page .bill-head text:nth-child(5) {
  text-align: right;
}

.bill-item-name {
  color: #333333;
  font-size: 23rpx;
  line-height: 1.25;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(0, 0, 0, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  box-sizing: border-box;
}

.record-modal {
  width: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.modal-actions {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
}

.modal-actions button {
  width: 100%;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  box-sizing: border-box;
}

.modal-actions .submit {
  margin-top: 0;
}

.cancel-button {
  background: #f2f2f2;
  color: #333333;
}

.cancel-button::after {
  border: 0;
}
