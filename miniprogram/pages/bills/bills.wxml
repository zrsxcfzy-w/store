<view class="page bills-page">
  <view class="title-row">
    <view class="page-title">账单</view>
    <view class="title-actions">
      <button class="add-record-button green-button" bindtap="openRecordModal">添加购买记录</button>
      <button class="batch-button" bindtap="toggleBatchDelete">{{batchDeleteMode ? '取消' : '批量删除'}}</button>
      <button class="batch-button fold-all-button" bindtap="toggleAllDateGroups">{{allGroupsCollapsed ? '批量展开账单' : '批量折叠账单'}}</button>
    </view>
  </view>

  <view wx:if="{{batchDeleteMode}}" class="batch-bar">
    <text>已选择 {{selectedDateCount}} 天</text>
    <button class="danger-button" bindtap="confirmBatchDeleteDates">确认删除</button>
  </view>

  <scroll-view scroll-y class="bills-scroll">
    <view class="date-group panel" wx:for="{{billGroups}}" wx:key="date">
      <view class="date-group-header">
        <view class="date-title-row">
          <view
            wx:if="{{batchDeleteMode}}"
            class="select-box {{item.selected ? 'selected' : ''}}"
            data-date="{{item.date}}"
            bindtap="toggleDateSelection"
          >{{item.selected ? '✓' : ''}}</view>
          <view class="fold-icon" data-date="{{item.date}}" bindtap="toggleDateGroup">{{item.expanded ? 'v' : '›'}}</view>
          <text class="date-title">{{item.displayDate}}</text>
        </view>
        <view class="date-summary">
          <text>购买了{{item.totalQuantity}}件物品，消费了{{item.totalAmount}}元</text>
        </view>
        <button class="group-delete-button" data-date="{{item.date}}" bindtap="deleteDateGroup">删除</button>
      </view>

      <view wx:if="{{item.expanded}}" class="group-records">
        <view class="bill-head">
          <text>平台</text>
          <text>物品</text>
          <text>价格(元)</text>
          <text>数量</text>
        </view>
        <view class="record" wx:for="{{item.records}}" wx:for-item="record" wx:key="id" data-id="{{record.id}}" bindlongpress="onRecordLongPress">
          <view class="platform">
            <text class="platform-badge" style="background-color: {{record.platformColor}};">{{record.platformMark}}</text>
            <view>
              <text class="platform-name" style="color: {{record.platformColor}};">{{record.displayPlatform}}</text>
            </view>
          </view>
          <view class="bill-item-name">{{record.itemName}}</view>
          <view class="price">{{record.price}}</view>
          <view class="quantity">{{record.quantity}}{{record.unit}}</view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{recordModalVisible}}" class="modal-mask" bindtap="closeRecordModal">
    <view class="record-modal panel" catchtap="noop">
      <view class="modal-title">添加购买记录</view>
      <picker range="{{items}}" range-key="name" value="{{itemIndex}}" bindchange="onItemChange">
        <view class="field">
          <text>物品</text>
          <text>{{selectedItemName}}</text>
        </view>
      </picker>
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
        <view class="field">
          <text>时间</text>
          <text>{{formDateText}}</text>
        </view>
      </picker>
      <picker range="{{platforms}}" value="{{platformIndex}}" bindchange="onPlatformChange">
        <view class="field">
          <text>平台</text>
          <text>{{form.platform}}</text>
        </view>
      </picker>
      <view wx:if="{{requiresPlatformDetail}}" class="field">
        <text>具体地点</text>
        <input placeholder="例如：比优特" value="{{form.platformDetail}}" bindinput="onPlatformDetailInput" />
      </view>
      <view class="field">
        <text>价格(元)</text>
        <input type="digit" placeholder="0.00" value="{{form.price}}" bindinput="onPriceInput" />
      </view>
      <view class="field">
        <text>数量</text>
        <input type="number" placeholder="1" value="{{form.quantity}}" bindinput="onQuantityInput" />
      </view>
      <view class="modal-actions">
        <button class="cancel-button" bindtap="closeRecordModal">取消</button>
        <button class="submit green-button" bindtap="submitBill">保存</button>
      </view>
    </view>
  </view>

  <view class="bottom-tabbar">
    <view class="tab-item" bindtap="goHome"><image class="tab-img" src="/assets/tab-home.png" mode="aspectFit"></image><text>首页</text></view>
    <view class="tab-item" bindtap="goInventory"><image class="tab-img" src="/assets/tab-inventory.png" mode="aspectFit"></image><text>库存</text></view>
    <view class="tab-item" bindtap="goReminder"><image class="tab-img" src="/assets/tab-reminder.png" mode="aspectFit"></image><text>提醒</text></view>
    <view class="tab-item active"><image class="tab-img" src="/assets/tab-bill-active.png" mode="aspectFit"></image><text>账单</text></view>
    <view class="tab-item" bindtap="goAccounting"><image class="tab-img" src="/assets/tab-accounting.png" mode="aspectFit"></image><text>记账</text></view>
    <view class="tab-item" bindtap="goProfile"><image class="tab-img" src="/assets/tab-profile.png" mode="aspectFit"></image><text>我的</text></view>
  </view>

  <onboarding-overlay
    visible="{{hintVisible}}"
    target="page-hint"
    title="账单页记录所有购买"
    text="这里按日期汇总每次采购。添加购买记录后，对应物品的库存、价格区间、购买周期和预计采购时间都会跟着更新。"
    primary-text="知道了"
    show-secondary="{{false}}"
    bind:primary="closeHint"
  />
</view>
