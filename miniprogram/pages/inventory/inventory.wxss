.list-page {
  padding-bottom: 148rpx;
  background: #fffdf9;
}

.page-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
}

.filter-row {
  margin-bottom: 18rpx;
  height: 66rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #eeeeee;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  overflow: hidden;
}

.filter-row button {
  height: 66rpx;
  line-height: 66rpx;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: #ffffff;
  color: #3f3f3f;
  font-size: 23rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  box-sizing: border-box;
}

.filter-row button::after {
  border: 0;
}

.filter-row button.active {
  background: linear-gradient(180deg, #70c884 0%, #5fbd78 100%);
  color: #ffffff;
  font-weight: 700;
}

.list-scroll {
  height: calc(100vh - 274rpx);
}

.summary-card {
  min-height: 168rpx;
  margin-bottom: 18rpx;
  padding: 16rpx;
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.summary-thumb {
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
}

.summary-info {
  flex: 1;
  display: grid;
  gap: 8rpx;
  color: #666666;
  font-size: 24rpx;
}

.summary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.summary-name {
  color: #222222;
  font-size: 30rpx;
  font-weight: 800;
}

.summary-pill {
  color: #ffffff;
  border-radius: 999rpx;
  padding: 7rpx 18rpx;
  font-size: 21rpx;
}

.danger {
  color: #ff7634;
  font-weight: 700;
}
