.bill-page {
  background: #fffdf9;
}

.bill-page .header-title {
  max-width: 330rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-add-button {
  position: absolute;
  right: 0;
  top: 5rpx;
  width: 172rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  z-index: 1;
}

.sort-row {
  margin: 18rpx 0 18rpx;
  height: 66rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #eeeeee;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  overflow: hidden;
}

.sort-row button {
  height: 66rpx;
  line-height: 66rpx;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: #ffffff;
  color: #3f3f3f;
  font-size: 21rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  box-sizing: border-box;
}

.sort-row button::after {
  border: 0;
}

.sort-row button.active {
  background: linear-gradient(180deg, #70c884 0%, #5fbd78 100%);
  color: #ffffff;
  font-weight: 700;
}

.bill-head {
  height: 66rpx;
  margin-bottom: 18rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  display: grid;
  grid-template-columns: 1.18fr 1.28fr 0.9fr 0.62fr;
  gap: 10rpx;
  align-items: center;
  color: #555555;
  font-size: 22rpx;
}

.bill-head text:nth-child(3) {
  text-align: center;
}

.bill-head text:nth-child(2) {
  padding-left: 54rpx;
  box-sizing: border-box;
}

.bill-head text:nth-child(4) {
  text-align: right;
}

.form,
.record-modal {
  padding: 18rpx;
  margin: 0;
}

.field {
  min-height: 70rpx;
  border-bottom: 1rpx solid #f1f1f1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #444444;
  font-size: 24rpx;
}

.field input {
  text-align: right;
  flex: 1;
}

.submit {
  margin-top: 18rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  background: rgba(0, 0, 0, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  box-sizing: border-box;
}

.record-modal {
  width: 100%;
  box-sizing: border-box;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.record {
  min-height: 136rpx;
  margin-bottom: 24rpx;
  padding: 0 20rpx;
  display: grid;
  grid-template-columns: 1.18fr 1.28fr 0.9fr 0.62fr;
  gap: 10rpx;
  align-items: center;
}

.record-date {
  color: #333333;
  font-size: 23rpx;
  line-height: 1.25;
}

.platform {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.platform-badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  background: #ff3b30;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
}

.platform-name {
  display: block;
  color: #333333;
  font-size: 23rpx;
}

.delivery-tag {
  margin-top: 8rpx;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #f4f4f4;
  color: #777777;
  font-size: 20rpx;
  display: inline-flex;
  align-items: center;
}

.price {
  color: #ff4a4a;
  font-size: 27rpx;
  font-weight: 700;
  text-align: center;
}

.quantity {
  color: #333333;
  font-size: 25rpx;
  text-align: right;
}
