<view class="page bill-page" wx:if="{{item}}">
  <view class="page-header">
    <view class="back-icon" bindtap="goBack">‹</view>
    <text class="header-title">{{item.name}}的购买记录</text>
    <view class="header-actions">
      <button class="header-add-button green-button" bindtap="openBillModal">添加购买记录</button>
      <button class="header-batch-button" bindtap="toggleBatchDelete">{{batchDeleteMode ? '取消' : '批量删除'}}</button>
    </view>
  </view>

  <view class="sort-row">
    <button class="{{sortMode === 'priceAsc' ? 'active' : ''}}" data-mode="priceAsc" bindtap="setSort">价格从低到高</button>
    <button class="{{sortMode === 'priceDesc' ? 'active' : ''}}" data-mode="priceDesc" bindtap="setSort">价格从高到低</button>
    <button class="{{sortMode === 'timeDesc' ? 'active' : ''}}" data-mode="timeDesc" bindtap="setSort">时间由近到远</button>
  </view>

  <view class="bill-head">
    <text>时间</text>
    <text>平台</text>
    <text>价格(元)</text>
    <text>数量</text>
  </view>

  <view wx:if="{{batchDeleteMode}}" class="batch-bar">
    <text>已选择 {{selectedBillCount}} 条</text>
    <button class="danger-button" bindtap="confirmBatchDeleteBills">确认删除</button>
  </view>

  <view class="record panel {{batchDeleteMode ? 'selecting' : ''}}" wx:for="{{sortedBills}}" wx:for-item="bill" wx:key="id" data-id="{{bill.id}}" bindlongpress="onRecordLongPress">
    <view
      wx:if="{{batchDeleteMode}}"
      class="select-box {{bill.selected ? 'selected' : ''}}"
      data-id="{{bill.id}}"
      bindtap="toggleBillSelection"
    >{{bill.selected ? '✓' : ''}}</view>
    <view class="record-date">{{bill.displayDate}}</view>
    <view class="platform">
      <text class="platform-badge" style="background-color: {{bill.platformColor}};">{{bill.platformMark}}</text>
      <view>
        <text class="platform-name" style="color: {{bill.platformColor}};">{{bill.displayPlatform}}</text>
      </view>
    </view>
    <view class="price">{{bill.price}}</view>
    <view class="quantity">{{bill.quantity}}{{unit}}</view>
  </view>

  <view wx:if="{{recordModalVisible}}" class="modal-mask" bindtap="closeBillModal">
    <view class="record-modal panel" catchtap="noop">
      <view class="modal-title">添加购买记录</view>
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
        <view class="field">
          <text>时间</text>
          <text>{{formDateText}}</text>
        </view>
      </picker>
      <picker range="{{platforms}}" value="{{platformIndex}}" bindchange="onPlatformChange">
        <view class="field">
          <text>平台</text>
          <text>{{form.platform}}</text>
        </view>
      </picker>
      <view wx:if="{{requiresPlatformDetail}}" class="field">
        <text>具体地点</text>
        <input placeholder="例如：比优特" value="{{form.platformDetail}}" bindinput="onPlatformDetailInput" />
      </view>
      <view class="field">
        <text>价格(元)</text>
        <input type="digit" placeholder="0.00" value="{{form.price}}" bindinput="onPriceInput" />
      </view>
      <view class="field">
        <text>数量({{item.unit}})</text>
        <input type="number" placeholder="1" value="{{form.quantity}}" bindinput="onQuantityInput" />
      </view>
      <button class="submit green-button" bindtap="submitBill">保存</button>
    </view>
  </view>
</view>
